# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub

PORT=3000

# PostgreSQL en Render — copia la "External Database URL" desde tu dashboard de Render
DATABASE_URL=postgresql://usuario:contraseña@host.render.com:5432/nombre_db

# JWT para autenticación (puedes poner cualquier string largo y secreto)
JWT_SECRET=cambia_esto_por_algo_secreto_largo_123
